generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  LIBRARY_OWNER
  LIBRARY_MANAGER
  LIBRARY_STAFF
  STUDENT
}

enum LibraryStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
  CLOSED
}

enum SeatType {
  STANDARD
  PREMIUM
  WINDOW
  CHARGING
  CABIN
  PRIVATE
  CORNER
  OTHER
}

enum SeatStatus {
  AVAILABLE
  BOOKED
  OCCUPIED
  MAINTENANCE
  DISABLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum OwnerMembershipLevel {
  STANDARD
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REJECTED
  INVALID
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  MEMBERSHIP_EXPIRING
  MEMBERSHIP_EXPIRED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  NEW_STUDENT
  NEW_MEMBERSHIP
  NEW_BOOKING
  PAYMENT_RECEIVED
  LIBRARY_APPROVED
  LIBRARY_REJECTED
  LIBRARY_SUSPENDED
  SUBSCRIPTION_EXPIRING
  PLATFORM_ALERT
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  mobile        String   @unique
  email         String?  @unique
  name          String
  passwordHash  String?
  role          Role
  profilePhoto  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  libraryOwner    LibraryOwner?
  student         Student?
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@map("users")
}

// ─── Library Owner ───────────────────────────────────────────────────────────

model LibraryOwner {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  libraries           Library[]
  subscription        OwnerSubscription?
  // Razorpay Route / settlement fields
  razorpayAccountId        String?   // acc_XXXXXXXXXX — created by platform via Route API
  razorpayAccountStatus    String?   @default("PENDING") // PENDING | UNDER_REVIEW | ACTION_REQUIRED | ACTIVE | SUSPENDED
  razorpayStakeholderId    String?   // sth_XXXXXXXXXX
  razorpayProductId        String?   // acc_prd_XXXXXXXXXX
  razorpayActivationStatus String?   // created | under_review | needs_clarification | activated | suspended
  settlementReady          Boolean   @default(false)
  settlementRequirements   Json?     // raw requirements array from Razorpay
  settlementActivatedAt    DateTime?
  bankLast4                String?   // last 4 digits of bank account — safe to display

  // ── Referral / Membership ─────────────────────────────────────────────────
  referralCode        String?  @unique  // e.g. "STUDYLIB-A82K9" — auto-generated on registration
  referredByOwnerId   String?           // LibraryOwner.id of the referrer (nullable)
  referredByOwner     LibraryOwner?     @relation("OwnerReferredBy", fields: [referredByOwnerId], references: [id])
  referredOwners      LibraryOwner[]    @relation("OwnerReferredBy")
  ownerMembershipLevel OwnerMembershipLevel @default(STANDARD)

  // Referral records where this owner is the referrer
  referralsGiven      OwnerReferral[]   @relation("ReferrerOwner")
  // Referral record where this owner is the referred party (at most one)
  referralReceived    OwnerReferral?    @relation("ReferredOwner")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  payments            OwnerPayment[]

  @@map("library_owners")
}

// ─── Library ─────────────────────────────────────────────────────────────────

model Library {
  id              String        @id @default(cuid())
  ownerId         String
  owner           LibraryOwner  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  logoUrl         String?
  coverPhotoUrl   String?
  phone           String?
  emailContact    String?
  status          LibraryStatus @default(PENDING_VERIFICATION)
  rejectionReason String?

  // Location
  addressLine1    String?
  addressLine2    String?
  area            String?
  landmark        String?
  city            String
  state           String
  pincode         String
  country         String        @default("India")
  latitude        Float?
  longitude       Float?
  formattedAddress String?

  // Settings
  bookingMode     String        @default("FLEXIBLE") // FLEXIBLE | FIXED_SLOT
  minBookingMins  Int           @default(30)
  maxBookingMins  Int           @default(480)
  bookingInterval Int           @default(15)
  is24Hours       Boolean       @default(false)
  basePrice       Float         @default(0)  // seat booking price in INR — replaces MembershipPlan pricing

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  photos          LibraryPhoto[]
  facilities      LibraryFacility[]
  hours           LibraryHours[]
  rules           LibraryRule[]
  seats           Seat[]
  seatLayout      SeatLayout?
  membershipPlans MembershipPlan[]
  studentMemberships StudentMembership[]
  bookings        Booking[]
  reviews         Review[]
  notifications   Notification[]

  @@map("libraries")
}

model LibraryPhoto {
  id         String   @id @default(cuid())
  libraryId  String
  library    Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  url        String
  category   String   @default("OTHER") // EXTERIOR | READING_HALL | SEATING_AREA | RECEPTION | FACILITIES | WASHROOM | OTHER
  isCover    Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("library_photos")
}

model LibraryFacility {
  id        String  @id @default(cuid())
  libraryId String
  library   Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  name      String  // WIFI | AC | POWER_BACKUP | etc.
  isCustom  Boolean @default(false)

  @@map("library_facilities")
}

model LibraryHours {
  id          String   @id @default(cuid())
  libraryId   String
  library     Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0=Sun, 1=Mon, ... 6=Sat
  isOpen      Boolean  @default(true)
  openTime    String?  // "09:00"
  closeTime   String?  // "22:00"
  breakStart  String?
  breakEnd    String?

  @@unique([libraryId, dayOfWeek])
  @@map("library_hours")
}

model LibraryRule {
  id        String  @id @default(cuid())
  libraryId String
  library   Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  rule      String
  order     Int     @default(0)

  @@map("library_rules")
}

// ─── Seats ───────────────────────────────────────────────────────────────────

model SeatLayout {
  id          String         @id @default(cuid())
  libraryId   String         @unique
  library     Library        @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  canvasWidth  Int           @default(800)
  canvasHeight Int           @default(600)
  objects     LayoutObject[]
  updatedAt   DateTime       @updatedAt

  @@map("seat_layouts")
}

model LayoutObject {
  id         String     @id @default(cuid())
  layoutId   String
  layout     SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  objectType String     // PILLAR | WALL | DOOR | WINDOW | RECEPTION | STAIRCASE | WASHROOM | TABLE | CABINET | PASSAGE | CUSTOM
  label      String?
  x          Float
  y          Float
  width      Float
  height     Float
  rotation   Float      @default(0)
  color      String?

  @@map("layout_objects")
}

model Seat {
  id          String     @id @default(cuid())
  libraryId   String
  library     Library    @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  label       String
  seatType    SeatType   @default(STANDARD)
  status      SeatStatus @default(AVAILABLE)
  x           Float
  y           Float
  width       Float      @default(60)
  height      Float      @default(60)
  rotation    Float      @default(0)
  extraPrice  Float?     // additional price on top of base, if any
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  bookings    Booking[]

  @@unique([libraryId, label])
  @@map("seats")
}

// ─── Students ────────────────────────────────────────────────────────────────

model Student {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId  String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships StudentMembership[]
  bookings    Booking[]
  payments    Payment[]
  attendance  Attendance[]
  reviews     Review[]

  @@map("students")
}

// ─── Membership Plans (Seat Pricing Packages) ────────────────────────────────

model MembershipPlan {
  id           String   @id @default(cuid())
  libraryId    String
  library      Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  name         String
  description  String?

  // ── Daily access duration ──────────────────────────────────────────────────
  dailyMinutes    Int    @default(60)   // minutes per day, e.g. 120 = 2 hrs/day

  // ── Plan duration (LEGACY - owner-defined, deprecated for new plans) ──────
  durationValue   Int    @default(1)    // e.g. 1, 3, 6, 12 (LEGACY_PACKAGE only)
  durationUnit    String @default("MONTH") // DAY | WEEK | MONTH | YEAR (LEGACY_PACKAGE only)
  durationDays    Int    @default(30)   // kept for backward compat; derived on write

  // ── Pricing Model ─────────────────────────────────────────────────────────
  pricingModel String  @default("LEGACY_PACKAGE") // LEGACY_PACKAGE | MONTHLY_RATE
  
  // ── Pricing (legacy field for backward compat) ────────────────────────────
  price        Float   // For LEGACY_PACKAGE: total package price. For MONTHLY_RATE: deprecated, use monthlyPrice
  
  // ── Monthly Rate Pricing (NEW - authoritative for MONTHLY_RATE plans) ────
  monthlyPrice Float?  // Price per month for this daily duration (e.g. ₹150/month for 2hrs/day)

  // ── Time selection mode ───────────────────────────────────────────────────
  timeSelectionMode  String  @default("FLEXIBLE") // FLEXIBLE | FIXED
  fixedStartTime     String? // "09:00" — only for FIXED plans
  fixedEndTime       String? // "11:00" — only for FIXED plans

  // ── Allowed days (0=Sun … 6=Sat). Empty = all days ───────────────────────
  allowedDays  Int[]   @default([0,1,2,3,4,5,6])

  benefits     String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentMemberships StudentMembership[]
  bookings           Booking[]

  @@index([pricingModel, isActive])
  @@unique([libraryId, dailyMinutes, pricingModel], name: "library_daily_monthly_unique")
  @@map("membership_plans")
}

model StudentMembership {
  id          String           @id @default(cuid())
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  libraryId   String
  library     Library          @relation(fields: [libraryId], references: [id])
  planId      String
  plan        MembershipPlan   @relation(fields: [planId], references: [id])
  status      MembershipStatus @default(PENDING)
  startDate   DateTime
  endDate     DateTime
  paidAmount  Float
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  payment     Payment?

  @@map("student_memberships")
}

// ─── Bookings ────────────────────────────────────────────────────────────────

model Booking {
  id           String        @id @default(cuid())
  libraryId    String
  library      Library       @relation(fields: [libraryId], references: [id])
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id])
  seatId       String
  seat         Seat          @relation(fields: [seatId], references: [id])

  // ── Plan reference (nullable for legacy one-off bookings) ─────────────────
  planId       String?
  plan         MembershipPlan? @relation(fields: [planId], references: [id])

  // ── Package period (for recurring plans) ─────────────────────────────────
  startDate         DateTime?     // package start date (date only, time = 00:00 UTC)
  endDate           DateTime?     // package end date
  dailyStartTime    String?       // "09:00"
  dailyEndTime      String?       // "11:00"

  // ── Snapshot: price at time of booking (immutable after creation) ─────────
  planNameSnapshot      String?
  planPriceSnapshot     Float?
  seatExtraSnapshot     Float?
  dailyMinutesSnapshot  Int?
  durationSnapshot      String?   // e.g. "3 MONTH" (legacy)
  monthlyPriceSnapshot  Float?    // Monthly rate at time of booking (for MONTHLY_RATE plans)
  selectedMonths        Int?      // Number of months student purchased (for MONTHLY_RATE plans)

  // ── Legacy single-occurrence fields (kept for backward compat) ───────────
  bookingDate  DateTime      // date portion
  startTime    DateTime
  endTime      DateTime

  status       BookingStatus @default(PENDING)
  totalAmount  Float
  bookingRef   String        @unique @default(cuid())
  notes        String?
  holdExpiresAt DateTime?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  payment      Payment?
  attendance   Attendance?
  occurrences  BookingOccurrence[]

  @@map("bookings")
}

// ─── Booking Occurrences ──────────────────────────────────────────────────────
// One row per actual daily slot in a recurring plan booking.

model BookingOccurrence {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatId     String   // denormalised for fast conflict queries
  date       DateTime // the calendar date (00:00 UTC)
  startTime  DateTime // full datetime of slot start
  endTime    DateTime // full datetime of slot end
  status     String   @default("HELD") // HELD | CONFIRMED | CANCELLED | EXPIRED

  createdAt  DateTime @default(now())

  @@index([seatId, startTime, endTime])
  @@index([bookingId])
  @@map("booking_occurrences")
}

// ─── Payments ────────────────────────────────────────────────────────────────

model Payment {
  id                  String        @id @default(cuid())
  studentId           String
  student             Student       @relation(fields: [studentId], references: [id])
  amount              Float
  status              PaymentStatus @default(PENDING)
  paymentMethod       String?       // RAZORPAY | CASH | UPI | CARD
  paymentType         String?       // SEAT_BOOKING | SUBSCRIPTION
  // Razorpay fields
  gatewayOrderId      String?
  gatewayPaymentId    String?
  gatewaySignature    String?
  gatewayTransferId   String?       // Razorpay transfer ID (for route to owner)
  refundId            String?
  refundAmount        Float?
  
  // Platform commission tracking (NEW MODEL: deducted FROM owner, not added to student)
  platformFee         Float?        // Amount kept by platform (5% of baseAmount, deducted from owner)
  ownerAmount         Float?        // Amount routed to library owner (baseAmount - platformFee)
  
  // Gateway fee recovery (separate from platform commission, recovered from student)
  gatewayFee          Float?        // Razorpay payment gateway fee (charged to student)
  gatewayFeeGst       Float?        // GST on gateway fee (charged to student)
  processingFee       Float?        // DEPRECATED: use gatewayFee instead
  gstAmount           Float?        // DEPRECATED: use gatewayFeeGst instead
  
  // Pricing breakdown
  baseAmount          Float?        // libraryBaseAmount (planPrice/monthlyPrice × months + seatExtra)
  planPrice           Float?        // Plan package price (legacy) or calculated amount (monthlyPrice × months)
  monthlyPrice        Float?        // Monthly rate used (for MONTHLY_RATE plans)
  selectedMonths      Int?          // Number of months purchased (for MONTHLY_RATE plans)
  seatExtraAmount     Float?        // Seat extra charge

  // Settlement / Route transfer tracking
  settlementStatus    String?       @default("NOT_REQUIRED") // NOT_REQUIRED | PENDING | PROCESSING | PROCESSED | FAILED | RETRY_REQUIRED | REVERSED
  transferFailureReason String?
  transferAttempts    Int?          @default(0)
  settledAt           DateTime?

  // Polymorphic: either booking or membership
  bookingId           String?       @unique
  booking             Booking?      @relation(fields: [bookingId], references: [id])
  membershipId        String?       @unique
  membership          StudentMembership? @relation(fields: [membershipId], references: [id])

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("payments")
}

// ─── Owner Subscription Payments ─────────────────────────────────────────────

model OwnerPayment {
  id                  String        @id @default(cuid())
  ownerId             String
  owner               LibraryOwner  @relation(fields: [ownerId], references: [id])
  amount              Float
  status              PaymentStatus @default(PENDING)
  paymentMethod       String?
  gatewayOrderId      String?
  gatewayPaymentId    String?
  gatewaySignature    String?
  subscriptionId      String?
  description         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("owner_payments")
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model Attendance {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  checkInAt   DateTime?
  checkOutAt  DateTime?
  createdAt   DateTime @default(now())

  @@map("attendance")
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  libraryId String
  library   Library  @relation(fields: [libraryId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@unique([libraryId, studentId])
  @@map("reviews")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  libraryId  String?
  library    Library?         @relation(fields: [libraryId], references: [id])
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  data       Json?
  createdAt  DateTime         @default(now())

  @@map("notifications")
}

// ─── Owner Subscriptions ─────────────────────────────────────────────────────

model SubscriptionPlan {
  id             String   @id @default(cuid())
  name           String
  description    String?
  price          Float    @default(0)
  billingCycle   String   @default("MONTHLY") // MONTHLY | YEARLY
  trialDays      Int      @default(0)
  maxSeats       Int?
  maxStudents    Int?
  maxStaff       Int?
  maxBranches    Int?
  features       String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions  OwnerSubscription[]

  @@map("subscription_plans")
}

model OwnerSubscription {
  id          String             @id @default(cuid())
  ownerId     String             @unique
  owner       LibraryOwner       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  planId      String
  plan        SubscriptionPlan   @relation(fields: [planId], references: [id])
  status      SubscriptionStatus @default(TRIAL)
  startDate   DateTime
  endDate     DateTime?
  trialEnd    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("owner_subscriptions")
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  role       Role?
  libraryId  String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

// ─── OTP Verifications ────────────────────────────────────────────────────────

model OtpVerification {
  id          String   @id @default(cuid())
  mobile      String
  otpHash     String   // bcrypt hash — never store plaintext
  purpose     String   // REGISTRATION | FORGOT_PASSWORD
  userType    String   // STUDENT | LIBRARY_OWNER
  expiresAt   DateTime
  attempts    Int      @default(0)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([mobile, purpose, userType])
  @@map("otp_verifications")
}

// ─── Owner Referrals ──────────────────────────────────────────────────────────

model OwnerReferral {
  id                String         @id @default(cuid())
  referrerOwnerId   String
  referrer          LibraryOwner   @relation("ReferrerOwner", fields: [referrerOwnerId], references: [id])
  referredOwnerId   String         @unique  // each referred owner has at most one referral record
  referred          LibraryOwner   @relation("ReferredOwner", fields: [referredOwnerId], references: [id])
  referredLibraryId String?        // set once the referred owner's library is created
  referralCode      String         // the code that was used at registration
  status            ReferralStatus @default(PENDING)
  registeredAt      DateTime       @default(now())
  qualifiedAt       DateTime?      // set when referred library becomes ACTIVE
  invalidatedAt     DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("owner_referrals")
}
